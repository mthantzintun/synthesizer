# ============================================================================
# Synthesizer configuration - copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. This template is committed, so never put a real secret in
# it.
#
# Precedence (highest first):
#   1. real environment variables / -D flags
#   2. this .env file
#   3. application.yaml defaults
# So `OPENROUTER_API_KEY=... ./mvnw spring-boot:run` overrides the file, which
# is what you want in CI. Leave a value blank to fall back to the default.
#
# docker compose also reads this file, which is why the Postgres credentials
# below must stay in sync with docker-compose.yml.
# ============================================================================

# ---------------------------------------------------------------- LLM access
# Required for phases 4-6 (extraction, contradictions, steelman).
# Phases 1-3 (ingest, chunk, embed) run without it - embeddings are local.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------- database
# Must match docker-compose.yml. Change both together, or point the URL at an
# external Postgres.
LITREVIEW_DB_URL=jdbc:postgresql://localhost:5432/litreview
LITREVIEW_DB_USER=litreview
LITREVIEW_DB_PASSWORD=litreview_dev
LITREVIEW_DB_POOL_SIZE=10

# Used by the postgres container in docker-compose.yml.
POSTGRES_DB=litreview
POSTGRES_USER=litreview
POSTGRES_PASSWORD=litreview_dev

# ---------------------------------------------------------------- pgadmin
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# ---------------------------------------------------------------- services
# "localhost" is correct when the app runs on the host and GROBID in a
# container. The Dockerfile overrides this to http://grobid:8070, since inside
# a container "localhost" is the container itself.
LITREVIEW_GROBID_URL=http://localhost:8070

# ---------------------------------------------------------------- corpus
# Leave unset to use the bundled src/main/resources copy. Set these to point at
# a corpus outside the repository.
# LITREVIEW_PDF_ROOT=src/main/resources/papers
# LITREVIEW_BIB_FILE=classpath:data/library.bib
# LITREVIEW_TEI_CACHE_DIR=.cache/tei

# ---------------------------------------------------------------- tuning
# Optional overrides for LitreviewProperties. Defaults are in application.yaml.
# LITREVIEW_EMBEDDING_DIMENSION=384
# LITREVIEW_CHUNKING_TARGET_CHARS=1200
# LITREVIEW_CHUNKING_MAX_CHARS=1800
# LITREVIEW_SEARCH_DEFAULT_TOP_K=12
# LITREVIEW_SYNTHESIS_FUTURE_WORK_SIMILARITY_THRESHOLD=0.62
# LITREVIEW_SYNTHESIS_MIN_PAPERS_PER_CONSTRUCT=2

